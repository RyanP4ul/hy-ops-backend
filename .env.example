# Copy to .env inside this workspace backend, then use your LOCAL/STAGING database.
# Reference .env files were deliberately not copied. Never commit real secrets.
DATABASE_URL=postgres://postgres:LOCAL_PASSWORD@127.0.0.1:5432/hyops_development
JWT_SECRET=REPLACE_WITH_A_RANDOM_ACCESS_SIGNING_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_REFRESH_SIGNING_SECRET
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HYOPS_ENABLE_INTEGRATIONS=false
HYOPS_ENABLE_AUTOMATION=false
PORT=5173
# Existing integration modules require configuration when imported. These are
# inactive local placeholders; integrations and automation above stay disabled.
LALAMOVE_API_KEY=disabled-local-placeholder
LALAMOVE_API_SECRET=disabled-local-placeholder
R2_ACCOUNT_ID=disabled
R2_ACCESS_KEY_ID=disabled
R2_SECRET_ACCESS_KEY=disabled
R2_BUCKET_NAME=disabled
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/disabled
GOOGLE_REFRESH_TOKEN=disabled

# External SMS side project; never expose SMS_ADMIN_KEY to the browser.
# Preserve your gateway's existing API_SMS_URL base. Paths used: /stats,
# /templates and /sms/send (the send path includes /sms).
API_SMS_URL=
SMS_ADMIN_KEY=

{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/index.ts",
    "build:exe": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts",
    "build:dist": "bun build --minify --target=bun --outdir=dist src/index.ts",
    "start:dev": "NODE_ENV=development bun run dist/index.js",
    "start": "NODE_ENV=production bun run dist/index.js",
	
    "db:generate": "bun --env-file=.env.development drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.development drizzle-kit migrate",
    "db:push": "bun --env-file=.env.development drizzle-kit push",
	
    "production:db:generate": "bun --env-file=.env.production drizzle-kit generate",
    "production:db:migrate": "bun --env-file=.env.production drizzle-kit migrate",
    "production:db:push": "bun --env-file=.env.production drizzle-kit push",
	
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:seed": "bun run src/db/seeds",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:rules": "oxlint --rules",
    "test": "bun run tests/run-tests.ts",
    "test:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-database.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@elysia/bearer": "^1.4.4",
    "@elysia/cors": "^1.4.2",
    "@elysia/jwt": "^1.4.2",
    "@elysia/openapi": "^1.4.17",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "exceljs": "^4.4.0",
    "googleapis": "^188.0.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.74.0"
  },
  "module": "src/index.js"
}
